# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard) and your own choices
# for the two ADMIN_* values. See README.md section 2-3 for the full walkthrough.

# ---------- Public (safe to expose to visitors' browsers) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------- Server-only (NEVER prefix these with NEXT_PUBLIC_) ----------
# Full database access, bypassing all security rules. Used only by the
# /admin dashboard's API routes, on the server. Supabase Project Settings ->
# API -> "service_role" / "secret" key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# The password you'll type in at https://your-site/admin to moderate listings.
ADMIN_PASSWORD=choose-a-password

# A long random string used to sign the admin login cookie so it can't be
# forged. Not something you need to remember -- generate one (40+ random
# characters) and paste it in once.
ADMIN_SESSION_SECRET=a-long-random-string

# ---------- Contact form email (optional but recommended) ----------
# Powers the "Need Help?" contact form's email notification. Sign up free
# at resend.com, verify a sending domain (or use their onboarding@resend.dev
# address for testing), and paste your API key below. If this is left
# blank, contact messages are still saved and visible in /admin -- they
# just won't also trigger an email.
RESEND_API_KEY=

# Where contact-form notifications get sent.
CONTACT_NOTIFY_EMAIL=admin@salehop.app

# The "from" address the notification email is sent as. Must be on a
# domain you've verified with Resend -- until you set one up, leave this
# as the default onboarding@resend.dev sender Resend provides for testing.
CONTACT_FROM_EMAIL=SaleHop <onboarding@resend.dev>
