# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard) and your own choices
# for the two ADMIN_* values. See README.md section 2-3 for the full walkthrough.

# ---------- Public (safe to expose to visitors' browsers) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------- Server-only (NEVER prefix these with NEXT_PUBLIC_) ----------
# Full database access, bypassing all security rules. Used only by the
# /admin dashboard's API routes, on the server. Supabase Project Settings ->
# API -> "service_role" / "secret" key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# The password you'll type in at https://your-site/admin to moderate listings.
ADMIN_PASSWORD=choose-a-password

# A long random string used to sign the admin login cookie so it can't be
# forged. Not something you need to remember -- generate one (40+ random
# characters) and paste it in once.
ADMIN_SESSION_SECRET=a-long-random-string
